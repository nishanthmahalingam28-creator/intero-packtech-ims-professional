# Copy this file to ".env" and fill in your values. NEVER commit the real .env file.

PORT=5000

# MongoDB Atlas -> Database -> Connect -> Drivers -> copy the connection string.
# Replace <username>, <password> and keep the database name (intero_ims) in the path.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/intero_ims?retryWrites=true&w=majority

# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Address(es) of the React app allowed to call this API (comma separated).
CLIENT_ORIGIN=http://localhost:5173

# First Super Admin, created by "npm run seed". Change the password after first login.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@interopacktech.demo
SUPER_ADMIN_PASSWORD=ChangeMe@12345

# Shared password for demo accounts: admin, manager, and sales.
DEMO_PASSWORD=ChangeMe@12345

# Frontend API URL (leave empty during local Vite development)
VITE_API_URL=
